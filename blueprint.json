{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/events/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": true,
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"permalink_structure": "/%postname%/",
				"timezone_string": "America/Vancouver"
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "openevents/openevents.php"
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require WP_PLUGIN_DIR . '/openevents/dev/sample-data.php'; flush_rewrite_rules();"
		}
	]
}
