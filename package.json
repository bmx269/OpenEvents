{
	"name": "open-events-calendar",
	"version": "0.1.0",
	"private": true,
	"description": "Open-source WordPress events calendar.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --experimental-modules --webpack-copy-php --blocks-manifest",
		"start": "wp-scripts start --experimental-modules --webpack-copy-php --blocks-manifest",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js ./src",
		"lint:css": "wp-scripts lint-style ./src",
		"lint:php": "composer lint",
		"plugin-zip": "wp-scripts plugin-zip",
		"playground": "wp-playground-cli server --blueprint=blueprint.json --auto-mount",
		"make-pot": "wp i18n make-pot . languages/open-events-calendar.pot --exclude=node_modules,vendor,src",
		"bench": "wp-playground-cli server --blueprint=dev/bench-blueprint.json --auto-mount"
	},
	"files": [
		"build",
		"inc",
		"templates",
		"languages",
		"open-events-calendar.php",
		"uninstall.php",
		"readme.txt"
	],
	"devDependencies": {
		"@wordpress/scripts": "^30.27.0",
		"@wp-playground/cli": "^3.1.61",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@wordpress/admin-ui": "^3.0.0",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/dataviews": "^21.0.0",
		"@wordpress/interactivity": "^8.0.0",
		"@wordpress/interactivity-router": "^3.0.0",
		"@wordpress/ui": "^0.25.0"
	}
}
