{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/events/",
	"preferredVersions": {
		"wp": "latest",
		"php": "8.3"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "setSiteOptions",
			"options": {
				"permalink_structure": "/%postname%/",
				"timezone_string": "America/Vancouver"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/bmx269/OpenEvents/playground/openevents.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require WP_PLUGIN_DIR . '/openevents/dev/sample-data.php'; delete_option( 'openevents_setup_redirect' ); flush_rewrite_rules();"
		},
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		}
	]
}
